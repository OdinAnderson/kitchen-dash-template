# Kitchen dashboard configuration. Copy to ~/.config/kitchen-dash/env, mode 600:
#
#   install -m 600 /dev/null ~/.config/kitchen-dash/env
#   $EDITOR ~/.config/kitchen-dash/env
#
# The systemd unit reads it via EnvironmentFile, which is parsed at process
# START — editing it has no effect until you restart the service.

# --- Microsoft Graph, app-only (client credentials) ----------------------
# An app registration granted "Application Calendars.Read" through Exchange Online
# RBAC for Applications, scoped to the one calendar mailbox (see README, Setup step 1).
# Do NOT also admin-consent Graph application permissions in Entra: those are
# tenant-wide and are added on top of the scoped Exchange grant.
# App-only (not delegated) on purpose: no user is present at a wall display.
TENANT_ID=
CLIENT_ID=
CLIENT_SECRET=

# The single mailbox whose calendar is displayed.
CALENDAR_MAILBOX=

# --- Air quality --------------------------------------------------------
# Free token from https://aqicn.org/data-platform/register
# The one setting whose absence is NOT fatal: without it the server logs that
# AQI is disabled, /api/air returns air_unavailable, and the tile falls back to
# a modelled estimate. Everything else still works.
WAQI_TOKEN=

# --- Optional -----------------------------------------------------------
# Port to listen on. The unit sets 8788; override only if that clashes.
#PORT=8788
